# Copy this file to .env and fill it in. Never commit .env to GitHub.
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=foodbank

# AI (free): get a key at https://aistudio.google.com/apikey  (Google keys start with AIza)
AI_API_KEY=paste_your_key_here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-3.8-flash
# To use Muse AI instead (paid): AI_API_URL=https://api.meta.ai/v1/chat/completions  AI_MODEL=muse-spark-1.3

# Email alerts (sent to the coordinators). Gmail: turn on 2-Step Verification, then make an
# App Password at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourteam.foodbank@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME=Surrey Community Food Bank

# Automatic checks while the app is open
AI_EVERY_HOURS=6            # full check: expiry + pickups
PICKUP_CHECK_MINUTES=15     # quick missed/delayed pickup check
