# Copy this file to .env and fill it in. Never commit .env to GitHub.
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=foodbank

# Muse AI (Meta Muse Spark)
MUSE_API_KEY=paste_your_key_here
# Leave these two commented out: the app tries Meta (api.meta.ai) first, then AI/ML API.
# MUSE_API_URL=https://api.meta.ai/v1/chat/completions
# MUSE_MODEL=muse-spark-1.3

# Email (optional). Without this, alerts are saved in Email_Log only (status "Logged only").
# Gmail: turn on 2-step verification, then create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourteam.foodbank@gmail.com
SMTP_PASS=your_16_char_app_password

# How often the automatic AI check runs (hours)
AI_EVERY_HOURS=6
